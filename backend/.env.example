# Banco de dados
DATABASE_URL="postgresql://mercado:mercado@localhost:5432/mercado?schema=public"

# Aplicação
PORT=3000
NODE_ENV=development
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:5173

# Deixe vazio em dev (sem proxy à frente). Em produção, atrás de um proxy
# reverso (Caddy/Nginx), defina o número de proxies — normalmente "1".
# Sem isto, o rate limit por IP vira global e o X-Forwarded-For do cliente
# passa a ser confiável (dá pra forjar). Ver docs/12-deploy-producao.md.
TRUST_PROXY=

# JWT
JWT_ACCESS_SECRET="troque-por-um-segredo-forte-de-acesso"
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_SECRET="troque-por-um-segredo-forte-de-refresh"
JWT_REFRESH_EXPIRES=7d

# MFA (TOTP) — opcional. Sem esta chave, deriva-se uma de JWT_ACCESS_SECRET
# (ok em dev). Em produção, gere a sua própria — assim rotacionar o JWT não
# invalida os segredos TOTP já cifrados no banco:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
MFA_ENCRYPTION_KEY=

# Admin inicial (seed)
SEED_ADMIN_EMAIL=admin@mercado.local
SEED_ADMIN_PASSWORD=Admin@123
SEED_ADMIN_NAME=Administrador

# Empresa inicial (seed)
SEED_EMPRESA_NOME="Meu Mercadinho"

# ── Pedidos por WhatsApp (Evolution API) ──
# Opcional: sem estas variáveis o módulo de pedidos funciona normalmente,
# apenas registrando as mensagens no banco em vez de enviá-las.
# EVOLUTION_API_KEY deve ser idêntica a EVOLUTION_API_KEY no .env da raiz do
# projeto (que o docker-compose injeta como AUTHENTICATION_API_KEY). Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
EVOLUTION_BASE_URL=http://localhost:8080
EVOLUTION_API_KEY=troque-por-uma-chave-forte
EVOLUTION_INSTANCE=mercadinho

# Segredo do webhook — obrigatório para receber mensagens.
# A Evolution deve chamar: POST /api/v1/webhooks/evolution?secret=<valor>
WEBHOOK_SECRET="troque-por-um-segredo-de-webhook"

# URL pública do catálogo enviada ao cliente no WhatsApp
CATALOG_PUBLIC_URL=http://localhost:5173/catalogo

# LGPD — dias até o expurgo automático de mensagens de WhatsApp (docs/11 §8).
# Rode POST /api/v1/lgpd/expurgo-mensagens periodicamente (cron externo) para
# aplicar. Ver docs/13-lgpd-retencao.md.
RETENCAO_MENSAGENS_DIAS=90

# ── Geocodificação reversa (endereço pela localização, catálogo WhatsApp) ──
# Serviço compatível com a API do Nominatim (OpenStreetMap). Gratuito e sem chave.
NOMINATIM_URL=https://nominatim.openstreetmap.org
# A política do Nominatim EXIGE um User-Agent que identifique a aplicação e
# dê um contato — sem isso o IP é bloqueado. Troque pelo e-mail real da loja.
GEOCODING_USER_AGENT=SistemaMercadinho/1.0 (contato: seu-email@exemplo.com)
