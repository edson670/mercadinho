# Lido pelo docker-compose.yml (variáveis ${...}) — não confundir com backend/.env
# ou frontend/.env. Copie para `.env` e ajuste.
#
# Gere cada segredo com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

# Segredo que a Evolution API usa para autenticar chamadas ao webhook do backend.
# DEVE ser idêntico ao WEBHOOK_SECRET em backend/.env.
WEBHOOK_SECRET=troque-por-um-segredo-de-webhook

# Chave global da Evolution API. DEVE ser idêntica a EVOLUTION_API_KEY em
# backend/.env. Quem tem esta chave controla a instância de WhatsApp da loja —
# trate como credencial de produção e nunca versione o valor real.
EVOLUTION_API_KEY=troque-por-uma-chave-forte

# Senha do PostgreSQL. Atenção: alterar aqui só afeta bancos criados do zero.
# Para um volume já existente, rode também:
#   docker exec -it mercado_postgres psql -U mercado -d mercado \
#     -c "ALTER USER mercado WITH PASSWORD 'nova-senha';"
# e atualize DATABASE_URL em backend/.env.
POSTGRES_PASSWORD=mercado

# Senha do pgAdmin (serviço opcional, profile "tools").
PGADMIN_PASSWORD=admin
